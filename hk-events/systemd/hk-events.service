[Unit]
Description=hk-events daily — aggregate HK tech/startup/AI + SME-buyer events, classify, push to Telegram, sync calendar
After=network-online.target claude-telegram.service
Wants=network-online.target
Requires=claude-telegram.service
# Cap self-heal retries at 3 attempts (RestartSec=300 apart -> ~15min span);
# after that systemd marks the unit failed rather than retrying forever.
StartLimitIntervalSec=1200
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Programming/claude-telegram/hk-events
ExecStart=%h/Documents/Programming/claude-telegram/hk-events/.venv/bin/python -m hk_events.orchestrator
StandardOutput=journal
StandardError=journal
# Backstop behind Task 2's 240s in-process fetch budget — 900s leaves ~11min
# of headroom above budget+classify+push+save for a normal run.
TimeoutStartSec=900
Restart=on-failure
RestartSec=300

[Install]
WantedBy=default.target
