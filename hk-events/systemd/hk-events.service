[Unit]
Description=hk-events daily — aggregate HK tech/startup/AI + SME-buyer events, classify, push to Telegram, sync calendar
After=network-online.target claude-telegram.service
Wants=network-online.target
Requires=claude-telegram.service
# Cap self-heal retries at 3 attempts, then let systemd mark the unit failed
# rather than retrying forever. NOTE: the naive "(burst-1) x (Timeout+Restart)
# ~= 2400s" arithmetic is NOT sufficient in practice and was proven wrong by
# reproduction (see task-3-report.md fix-round-1): a scaled systemd-run --user
# transient unit (9s-fail/3s-RestartSec cycle, burst=3) still restarted past
# 9 times with a 2x-cycle interval (36s) and only actually tripped
# ("Start request repeated too quickly") at a 5x-cycle interval (60s).
# Scaling that verified 5x ratio to the real 900s+300s=1200s cycle gives:
StartLimitIntervalSec=6000
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Programming/claude-telegram/hk-events
ExecStart=%h/Documents/Programming/claude-telegram/hk-events/.venv/bin/python -m hk_events.orchestrator
StandardOutput=journal
StandardError=journal
# Backstop behind Task 2's 240s in-process fetch budget — 900s leaves ~11min
# of headroom above budget+classify+push+save for a normal run.
TimeoutStartSec=900
Restart=on-failure
RestartSec=300

[Install]
WantedBy=default.target
