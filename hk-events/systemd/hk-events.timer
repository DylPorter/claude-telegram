[Unit]
Description=Trigger hk-events daily

[Timer]
# Daily 09:30 HKT — after job-sift (09:00) so the two morning digests don't
# collide on the Telegram push endpoint or the Claude CLI.
OnCalendar=*-*-* 09:30:00 Asia/Hong_Kong
# Catch up if we missed a run (e.g. laptop was asleep).
Persistent=true
RandomizedDelaySec=60
Unit=hk-events.service

[Install]
WantedBy=timers.target
