# hk-events env vars. These layer on top of claude-telegram/.env (which already
# holds PUSH_SECRET, CLAUDE_BIN, DEFAULT_CWD, etc). Put hk-events-specific
# overrides here, or add them to the shared claude-telegram/.env.

# Classifier model (haiku is plenty for binary room classification).
# HK_EVENTS_MODEL=haiku

# Google Workspace CLI binary (used for calendar writes). On PATH by default.
# GWS_BIN=gws

# --- Calendar writes ---
# MASTER SWITCH for real calendar writes. Default OFF (0). The orchestrator will
# only validate (gws --dry-run) until you set this to 1. Set it ON once you've
# watched a dry run and trust the output.
# HK_EVENTS_CALENDAR_ENABLED=0
#
# Target calendar. "primary" = your main calendar. Strongly recommended: create
# a dedicated secondary calendar in Google Calendar ("HK Events") and put its
# ID here so auto-added events stay segregated and easy to bulk-delete.
# HK_EVENTS_CALENDAR_ID=primary

# Only consider events starting within this rolling window (days).
# HK_EVENTS_HORIZON_DAYS=45

# Hard wall-clock budget for the whole (concurrent) source-fetch phase, in
# seconds. Default 240. Anything still running when it expires is abandoned
# and recorded as a failed source; the run continues with what landed. This
# is the real ceiling — an httpx timeout does NOT bound a getaddrinfo block.
# Raise it only if you also raise the unit's TimeoutStartSec (currently 900).
# HK_EVENTS_FETCH_BUDGET_S=240

# Vault archive subfolder (defaults to "Inbox/HK Events").
# HK_EVENTS_ARCHIVE_DIR=Inbox/HK Events

# --- Board delivery ---
# Where the board is SERVED. Set it and the summary bubble carries a Markdown
# link and NOTHING is attached — the URL is always current, so re-sending the
# file daily only piles up copies in the chat. http(s) only; any other scheme
# is refused with a warning. UNSET = OFF, and it WINS over _BOARD_ATTACH.
# HK_EVENTS_BOARD_URL=https://boards.example.test/events-board.html
#
# FALLBACK when no URL is set: attach the board as a Telegram document. The
# value is a board KEY out of the BOT's PUSH_DOCUMENTS allowlist, never a path.
# HK_EVENTS_BOARD_ATTACH=events-board

# Log level (DEBUG to see per-event classifier + gws cmd traces).
# HK_EVENTS_LOG_LEVEL=INFO
