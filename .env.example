# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user ID (only this user can message the bot)
# Get yours by messaging @userinfobot
TELEGRAM_ALLOWED_USER_ID=

# Claude CLI binary (full path)
CLAUDE_BIN=${HOME}/.local/bin/claude

# Default working directory for Claude sessions
DEFAULT_CWD=/path/to/your/vault

# Where to stash session state
STATE_DIR=/path/to/claude-telegram/.data

# Claude model alias for this bot (sonnet | haiku | opus, or full model ID).
# Sonnet 4.6 + low effort is the chat-from-phone sweet spot.
CLAUDE_MODEL=sonnet

# Thinking budget: low | medium | high | xhigh | max.
# "low" keeps replies snappy for capture-style messages.
CLAUDE_EFFORT=low

# Outbound /push endpoint (localhost only) for scheduled briefs and external pushes.
# Generate a secret with: openssl rand -hex 32
PUSH_PORT=7421
PUSH_SECRET=

# Board delivery (POST /push-document). Comma-separated `key=/absolute/path`.
#
# UNSET = the endpoint is DISABLED. Leave it blank unless you actually want the
# generated HTML boards pushed to your phone as Telegram attachments.
#
# Callers name a KEY, never a path — this list is the only place a sendable
# path exists, so /push-document cannot be turned into an arbitrary file read.
# Add ONLY files you are willing to have sent to your Telegram account.
#
# PUSH_DOCUMENTS=job-board=/absolute/path/to/Job Board.html,events-board=/absolute/path/to/Events Board.html
