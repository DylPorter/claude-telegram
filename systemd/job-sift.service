[Unit]
Description=job-sift daily — scrape CEDARS, classify, push prestige matches to Telegram
After=network-online.target claude-telegram.service
Wants=network-online.target
Requires=claude-telegram.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Programming/claude-telegram/job-sift
ExecStart=%h/Documents/Programming/claude-telegram/job-sift/.venv/bin/python -m job_sift.orchestrator
StandardOutput=journal
StandardError=journal
# 10-minute cap — classifier is fast (haiku, per-listing), most time is scraping.
TimeoutStartSec=600

[Install]
WantedBy=default.target
