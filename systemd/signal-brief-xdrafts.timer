[Unit]
Description=Trigger signal-brief x-drafts daily

[Timer]
# 08:30 HKT — after the 07:00 morning brief, before job-sift at 09:00.
OnCalendar=*-*-* 08:30:00 Asia/Hong_Kong
# Catch up if we missed a run (e.g. laptop was asleep).
Persistent=true
RandomizedDelaySec=60
Unit=signal-brief-xdrafts.service

[Install]
WantedBy=timers.target
